# Everything in the repo root is uploaded as public static assets (wrangler.jsonc
# "assets.directory": "."), so anything that is not part of the website must be
# listed here or it becomes downloadable from https://hentaivault.me/<path>.

# VCS / tooling
.git
.github
.gitignore
.gitattributes
.assetsignore
.wrangler
.wrangler-state/
.unlighthouse/
.dev.vars*
.env*
.vscode/
.idea/
node_modules/
package.json
package-lock.json
wrangler.jsonc
*.bat
*.sh
deploy.bat

# Source code, build and automation scripts (served content is built from these)
src/
scripts/
bot/
migrations/
extension/
css/src/
/*.js
!sw.js
temp_data.js
*.py
__pycache__/
scratch/

# Data dumps, reports, logs and SQL — private analytics and database exports
reports/
tmp/
*.sql
*.log
*.orig
*.md
audit_report.json
sitemap.xml

# Stray / unused pages
temp_review.html
live.html
cd

# Merged memevault app (separate Express app, not part of hentaivault.me)
memevault

# Local-only archive
_archive

# Service-account keys and other credentials (never public)
gsc-credentials.json
*credentials*.json
