# Server Configuration
PORT=8080
NODE_ENV=production

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Database Configuration (Render PostgreSQL)
DATABASE_URL=postgres://user:password@hostname:port/database

# Cloudflare R2 Configuration (S3-compatible)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your_custom_domain_or_r2_subdomain.com

# ── HotStuff Bot API Keys (optional — unlocks more sources) ──
# Giphy: https://developers.giphy.com (free, 1000 req/day)
GIPHY_API_KEY=your_giphy_api_key

# Tenor (Google GIFs): https://tenor.com/developer (free)
TENOR_API_KEY=your_tenor_api_key

# Imgur: https://api.imgur.com/oauth2/addclient (free)
IMGUR_CLIENT_ID=your_imgur_client_id
