# wrangler files
.wrangler
.wrangler-state/
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Dependencies
node_modules/
bot/node_modules/

# Scraper / dev tools
scraper.py
*.py
!scripts/*.py
__pycache__/

# OS
.DS_Store
Thumbs.db

# DB files and exports (D1 dumps contain the whole directory — keep them out of this public repo)
insert_*.sql
*.sqlite3
tmp/
scripts/scout-inserts.sql

# Raw analytics exports (GSC/Cloudflare data — keep out of this public repo)
reports/raw-data/
reports/site-audit.json

# Local tooling output
.unlighthouse/
*.orig

# Editor
.vscode/
.idea/

# Scratch
scratch/
deploy.bat

# Bot secrets
bot/.env

# GSC credentials (never commit)
gsc-credentials.json
fetch-gsc.js
*.json.key

# Local-only archive (never commit)
_archive/
